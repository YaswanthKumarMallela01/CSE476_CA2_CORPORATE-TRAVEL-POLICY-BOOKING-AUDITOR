# Google Gemini API key (REQUIRED)
# Get it free from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model name for Gemini chat completion (optional, default: gemini-3-flash-preview)
GEMINI_MODEL_NAME=

# Log level: DEBUG, INFO, WARNING, ERROR (optional, default: INFO)
LOG_LEVEL=

# Override "today" date for reproducible date logic (optional, default: 2026-11-12)
# Format: YYYY-MM-DD
TODAY_DATE=

# Rate limiter: max LLM requests per minute (optional, default: 15)
RATE_LIMIT_RPM=

# Rate limiter: max retries on 429/503 (optional, default: 3)
RATE_LIMIT_MAX_RETRIES=

# RAG: top-k results per retrieval query (optional, default: 5)
RAG_TOP_K=

# Chroma DB persist directory (optional, default: ./chroma_db)
CHROMA_PERSIST_DIR=

# LLM disk cache directory (optional, default: ./llm_cache)
LLM_CACHE_DIR=

# SQLite database path (optional, default: ./travel_auditor.db)
SQLITE_DB_PATH=

# Sentence-transformers embedding model (optional, default: all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=
